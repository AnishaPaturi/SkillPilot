# ==============================================================================
# SkillPilot .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets (Prevent leaking API keys)
.env
.env.local
.env.*.local
!.env.example

# Testing, Cache & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
htmlcov/
.hypothesis/

# Build & Distribution
build/
dist/
*.egg-info/
*.egg
wheels/

# Streamlit
.streamlit/

# IDEs & Editors
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# OS Specific
.DS_Store
Thumbs.db
Desktop.ini

# Antigravity / Scratch / Local Agent Workspace Cache
.kilo/
scratch/
